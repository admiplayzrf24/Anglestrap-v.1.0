```lua
--[[
    ANGLESTRAP v1.3
    Combined Preset Manager
    Roblox Studio LocalScript

    Features:
    - Create and delete presets
    - Select presets
    - JSON import and export
    - Freeze Self toggle for private testing
    - Touch-friendly interface

    Presets are data only. Imported Lua is never executed.
]]

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local presets = {}
local selectedPreset = nil
local frozen = false
local originalWalkSpeed = nil
local originalJumpPower = nil
local originalJumpHeight = nil
local originalAutoRotate = nil

-- Theme
local BG = Color3.fromRGB(17, 17, 24)
local PANEL = Color3.fromRGB(29, 29, 40)
local ACCENT = Color3.fromRGB(145, 80, 255)
local TEXT = Color3.fromRGB(245, 245, 255)
local GREEN = Color3.fromRGB(55, 155, 100)
local RED = Color3.fromRGB(175, 60, 70)

-- Remove an older copy of the UI.
local playerGui = player:WaitForChild("PlayerGui")
local oldGui = playerGui:FindFirstChild("Anglestrap")
if oldGui then
    oldGui:Destroy()
end

-- Screen GUI
local gui = Instance.new("ScreenGui")
gui.Name = "Anglestrap"
gui.ResetOnSpawn = false
gui.DisplayOrder = 10
gui.Parent = playerGui

-- Main window
local main = Instance.new("Frame")
main.Name = "Main"
main.Size = UDim2.new(0, 350, 0, 550)
main.Position = UDim2.new(0.5, -175, 0.5, -275)
main.BackgroundColor3 = BG
main.BorderSizePixel = 0
main.Parent = gui

local mainCorner = Instance.new("UICorner")
mainCorner.CornerRadius = UDim.new(0, 12)
mainCorner.Parent = main

local sizeConstraint = Instance.new("UISizeConstraint")
sizeConstraint.MinSize = Vector2.new(280, 400)
sizeConstraint.MaxSize = Vector2.new(450, 650)
sizeConstraint.Parent = main

-- Header
local header = Instance.new("TextLabel")
header.Name = "Header"
header.Size = UDim2.new(1, -50, 0, 38)
header.Position = UDim2.new(0, 12, 0, 8)
header.BackgroundTransparency = 1
header.Text = "ANGLESTRAP"
header.TextColor3 = ACCENT
header.TextSize = 23
header.Font = Enum.Font.GothamBold
header.TextXAlignment = Enum.TextXAlignment.Left
header.Parent = main

local closeButton = Instance.new("TextButton")
closeButton.Size = UDim2.new(0, 32, 0, 32)
closeButton.Position = UDim2.new(1, -42, 0, 8)
closeButton.BackgroundColor3 = RED
closeButton.Text = "X"
closeButton.TextColor3 = TEXT
closeButton.Font = Enum.Font.GothamBold
closeButton.TextSize = 14
closeButton.Parent = main

Instance.new("UICorner", closeButton).CornerRadius =
    UDim.new(0, 7)

closeButton.Activated:Connect(function()
    gui:Destroy()
end)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -24, 0, 25)
status.Position = UDim2.new(0, 12, 0, 43)
status.BackgroundTransparency = 1
status.Text = "Community preset manager"
status.TextColor3 = TEXT
status.TextSize = 11
status.Font = Enum.Font.Gotham
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

-- Scrollable content
local content = Instance.new("ScrollingFrame")
content.Name = "Content"
content.Position = UDim2.new(0, 10, 0, 75)
content.Size = UDim2.new(1, -20, 1, -85)
content.BackgroundColor3 = PANEL
content.BorderSizePixel = 0
content.ScrollBarThickness = 5
content.CanvasSize = UDim2.new(0, 0, 0, 0)
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.ScrollingDirection = Enum.ScrollingDirection.Y
content.Parent = main

Instance.new("UICorner", content).CornerRadius =
    UDim.new(0, 8)

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 10)
padding.PaddingBottom = UDim.new(0, 12)
padding.PaddingLeft = UDim.new(0, 10)
padding.PaddingRight = UDim.new(0, 10)
padding.Parent = content

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 7)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = content

-- UI helpers
local function addLabel(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 24)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = TEXT
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextWrapped = true
    label.Parent = content
    return label
end

local function addInput(placeholder, height)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, 0, 0, height or 36)
    box.BackgroundColor3 = BG
    box.TextColor3 = TEXT
    box.PlaceholderColor3 = Color3.fromRGB(160, 160, 175)
    box.PlaceholderText = placeholder
    box.Text = ""
    box.ClearTextOnFocus = false
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.TextWrapped = true
    box.Parent = content

    Instance.new("UICorner", box).CornerRadius =
        UDim.new(0, 6)

    return box
end

local function addButton(text, color, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = color or ACCENT
    button.TextColor3 = TEXT
    button.Text = text
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.TextWrapped = true
    button.Parent = content

    Instance.new("UICorner", button).CornerRadius =
        UDim.new(0, 6)

    button.Activated:Connect(callback)
    return button
end

-- Preset fields
addLabel("CREATE A PRESET")

local nameInput = addInput("Preset name")
local creatorInput = addInput("Creator name")
local categoryInput = addInput(
    "Category: Height, Freeze, Anti-Ace, Other"
)

-- Preset list
addLabel("SAVED PRESETS")

local presetList = Instance.new("Frame")
presetList.Size = UDim2.new(1, 0, 0, 0)
presetList.AutomaticSize = Enum.AutomaticSize.Y
presetList.BackgroundTransparency = 1
presetList.Parent = content

local presetLayout = Instance.new("UIListLayout")
presetLayout.Padding = UDim.new(0, 5)
presetLayout.Parent = presetList

local function refreshList()
    for _, child in ipairs(presetList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for index, preset in ipairs(presets) do
        local isSelected = selectedPreset == index

        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, 0, 0, 42)
        button.BackgroundColor3 = isSelected
            and Color3.fromRGB(90, 55, 155)
            or BG

        button.TextColor3 = TEXT
        button.TextSize = 11
        button.Font = Enum.Font.Gotham
        button.TextWrapped = true
        button.Text = preset.name .. " | " ..
            preset.creator .. " | " .. preset.category
        button.Parent = presetList

        Instance.new("UICorner", button).CornerRadius =
            UDim.new(0, 6)

        button.Activated:Connect(function()
            selectedPreset = index
            status.Text = "Selected: " .. preset.name
            refreshList()
        end)
    end
end

-- Create preset
addButton("＋ CREATE PRESET", GREEN, function()
    local name = nameInput.Text
    local creator = creatorInput.Text
    local category = categoryInput.Text

    if name == "" or creator == "" or category == "" then
        status.Text = "Fill in all preset fields"
        return
    end

    if #presets >= 100 then
        status.Text = "Maximum of 100 presets reached"
        return
    end

    if #name > 80 or #creator > 80 or #category > 40 then
        status.Text = "One of the fields is too long"
        return
    end

    table.insert(presets, {
        name = name,
        creator = creator,
        category = category,
        settings = {}
    })

    nameInput.Text = ""
    creatorInput.Text = ""
    categoryInput.Text = ""

    status.Text = "Preset created!"
    refreshList()
end)

-- Delete selected preset
addButton("DELETE SELECTED PRESET", RED, function()
    if not selectedPreset then
        status.Text = "Select a preset first"
        return
    end

    table.remove(presets, selectedPreset)
    selectedPreset = nil

    status.Text = "Preset deleted"
    refreshList()
end)

-- JSON import input
addLabel("IMPORT PRESETS — JSON")

local importBox = addInput(
    "Paste a JSON array of presets here",
    100
)
importBox.MultiLine = true
importBox.TextXAlignment = Enum.TextXAlignment.Left
importBox.TextYAlignment = Enum.TextYAlignment.Top
importBox.Font = Enum.Font.Code

addButton("IMPORT JSON", GREEN, function()
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(importBox.Text)
    end)

    if not ok or type(decoded) ~= "table" then
        status.Text = "Invalid JSON"
        return
    end

    local count = #decoded

    if count == 0 then
        status.Text = "JSON array is empty"
        return
    end

    if count > 100 or #presets + count > 100 then
        status.Text = "Preset limit exceeded"
        return
    end

    local validated = {}

    -- Validate before importing anything.
    for _, preset in ipairs(decoded) do
        if type(preset) ~= "table"
            or type(preset.name) ~= "string"
            or type(preset.creator) ~= "string"
            or type(preset.category) ~= "string"
            or type(preset.settings) ~= "table"
        then
            status.Text = "Invalid preset format"
            return
        end

        if #preset.name > 80
            or #preset.creator > 80
            or #preset.category > 40
        then
            status.Text = "Preset field too long"
            return
        end

        table.insert(validated, {
            name = preset.name,
            creator = preset.creator,
            category = preset.category,
            settings = preset.settings
        })
    end

    for _, preset in ipairs(validated) do
        table.insert(presets, preset)
    end

    importBox.Text = ""
    status.Text = "Imported " .. #validated .. " presets"
    refreshList()
end)

-- JSON export output
addLabel("EXPORT PRESETS — JSON")

local exportBox = addInput(
    "Exported JSON will appear here for copying",
    120
)
exportBox.MultiLine = true
exportBox.TextXAlignment = Enum.TextXAlignment.Left
exportBox.TextYAlignment = Enum.TextYAlignment.Top
exportBox.Font = Enum.Font.Code

addButton("EXPORT JSON", ACCENT, function()
    local ok, result = pcall(function()
        return HttpService:JSONEncode(presets)
    end)

    if not ok then
        status.Text = "Export failed"
        return
    end

    exportBox.Text = result
    status.Text = "JSON ready to copy"
end)

-- Freeze Self: local-only test control.
addLabel("PRIVATE TESTING")

local freezeButton

local function setFrozen(enable)
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    local humanoid = character
        and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid then
        status.Text = "Character not ready"
        return
    end

    if enable and not frozen then
        originalWalkSpeed = humanoid.WalkSpeed
        originalJumpPower = humanoid.JumpPower
        originalJumpHeight = humanoid.JumpHeight
        originalAutoRotate = humanoid.AutoRotate

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.JumpHeight = 0
        humanoid.AutoRotate = false
        frozen = true
    elseif not enable and frozen then
        humanoid.WalkSpeed = originalWalkSpeed or 16
        humanoid.JumpPower = originalJumpPower or 50
        humanoid.JumpHeight = originalJumpHeight or 7.2
        humanoid.AutoRotate =
            originalAutoRotate == nil and true
            or originalAutoRotate

        frozen = false
    end

    if freezeButton then
        freezeButton.Text = frozen
            and "UNFREEZE SELF"
            or "FREEZE SELF"
    end

    status.Text = frozen
        and "Freeze Self enabled"
        or "Freeze Self disabled"
end

freezeButton = addButton("FREEZE SELF", RED, function()
    setFrozen(not frozen)
end)

-- Reset freeze state on respawn.
player.CharacterAdded:Connect(function()
    frozen = false
    originalWalkSpeed = nil
    originalJumpPower = nil
    originalJumpHeight = nil
    originalAutoRotate = nil

    if freezeButton and freezeButton.Parent then
        freezeButton.Text = "FREEZE SELF"
    end
end)

-- Footer
addLabel("ANGLESTRAP v1.3 | PRESET DATA ONLY")

refreshList()

print("Anglestrap v1.3 loaded")
```
